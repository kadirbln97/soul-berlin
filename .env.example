# --- Datenbank (Postgres, z.B. kostenlos über Vercel/Neon oder Supabase) ---
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- App ---
# Öffentliche URL der Seite (lokal: http://localhost:3000)
APP_URL="http://localhost:3000"
# Langer zufälliger String — signiert Login-Sessions UND Ticket-QR-Codes.
# Erzeugen z.B. mit: openssl rand -hex 32
APP_SECRET="change-me-to-a-long-random-string"

# --- Admin-Login (Dashboard + Scanner) ---
ADMIN_EMAIL="you@soul-berlin.example"
# Bcrypt-Hash eines Passworts, NICHT das Passwort im Klartext.
# Erzeugen mit: npm run hash-password -- "DeinPasswort123"
ADMIN_PASSWORD_HASH="$2a$10$replace-with-generated-hash"
# Optional weitere Admin-Konten (z.B. für den zweiten Betreiber), damit im
# Check-in-Protokoll nachvollziehbar ist, wer eingecheckt hat.
# Format: "email:bcrypt-hash", mehrere durch Komma getrennt.
ADMIN_USERS=""
# Optional: zweiter Faktor (Einmalcode aus der Authenticator-App) für ALLE
# Admin-Logins. Erzeugen und aufs Handy holen mit:
#   npm run totp-secret -- "deine@email.de"
# Leer lassen = Login nur mit E-Mail und Passwort.
ADMIN_TOTP_SECRET=""

# --- Bild-Upload (Vercel Blob) ---
# Wird von Vercel automatisch gesetzt, sobald im Projekt ein Blob-Store
# verbunden ist (Storage → Connect). Lokal aus den Vercel-Projekteinstellungen
# kopieren, wenn Uploads getestet werden sollen.
BLOB_READ_WRITE_TOKEN=""

# --- Kontaktformular ---
# Optional: Empfänger für Nachrichten aus dem Kontaktformular. Kann auch
# bequem im Admin-Bereich unter "Startseite → Kontakt" gesetzt werden (das
# hat Vorrang). Ohne beides gehen Nachrichten an ADMIN_EMAIL.
CONTACT_EMAIL=""

# --- Stripe (nur für kostenpflichtige Events nötig) ---
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# https://dashboard.stripe.com/webhooks -> Endpoint für /api/webhooks/stripe anlegen
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- E-Mail-Versand (SMTP) — für Ticket-Zustellung mit QR-Code ---
# Funktioniert mit jedem SMTP-Anbieter (z.B. Resend, Postmark, Brevo, Gmail-App-Passwort)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="apikey-oder-username"
SMTP_PASS="dein-smtp-passwort"
SMTP_FROM="SØUL Berlin <no-reply@soul-berlin.example>"

# --- Täglicher Aufräumlauf (Löschung/Anonymisierung 90 Tage nach dem Event) ---
# Vercel schickt diesen Wert bei Cron-Aufrufen als "Authorization: Bearer …".
# In den Vercel-Projekteinstellungen als Umgebungsvariable setzen; ohne ihn
# läuft der Job bewusst nicht. Erzeugen z.B. mit: openssl rand -hex 32
CRON_SECRET=""

# --- Tischplan: automatische Tischerkennung (optional) ---
# Schlüssel von console.anthropic.com. Ohne ihn bleibt der Knopf „Tische
# automatisch erkennen“ im Admin ohne Funktion; zeichnen geht immer.
# Kostet pro Erkennung etwa einen Cent.
ANTHROPIC_API_KEY=""
# Optional anderes Modell (Standard: claude-sonnet-5).
ANTHROPIC_MODEL=""

# --- Fehler-Alarm ---
# Optional: Empfänger für Alarm-Mails bei Serverfehlern (siehe
# src/instrumentation.ts). Ohne Wert gehen sie an ADMIN_EMAIL.
ALERT_EMAIL=""
