// SØUL Berlin — Datenbankschema
//
// Datenbank: Postgres (kostenlos z.B. über Vercel/Neon oder Supabase — nötig für
// Deployment auf Vercel, da SQLite dort nicht funktioniert/persistiert).
// Lokale Entwicklung: entweder eine lokale Postgres-Instanz oder einfach dieselbe
// kostenlose Neon/Supabase-Datenbank auch für "npm run dev" verwenden.
// Enums werden bewusst NICHT verwendet — Werte werden stattdessen per Zod im Code
// validiert (siehe src/lib/validation.ts), das hält das Schema portabel.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  subtitle    String?
  description String
  venue       String
  address     String?
  imageUrl    String?
  dateStart   DateTime
  dateEnd     DateTime?

  // "PAID" | "GUESTLIST" | "BOTH" (Ticketkauf + Gästeliste parallel, Gast wählt selbst)
  ticketMode  String   @default("GUESTLIST")

  // Preis in Cent (relevant bei ticketMode = PAID oder BOTH)
  priceCents  Int?
  currency    String   @default("eur")

  // optionales Kapazitätslimit (null = unbegrenzt)
  capacity    Int?

  // Optionaler Zeitpunkt, ab dem Gästeliste/Ticketverkauf automatisch
  // schließt (null = kein Verkaufsschluss). Wird auf der Event-Seite als
  // Countdown angezeigt; Checkout/Gästeliste-APIs lehnen Anmeldungen danach ab.
  ticketSalesEndAt DateTime?

  // "DRAFT" | "PUBLISHED"
  status      String   @default("DRAFT")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets         Ticket[]
  guestlistTiers  GuestlistTier[]
}

// Bis zu 3 zeitbasierte Preis-Staffeln für Gästeliste-Events (z.B. "bis 23 Uhr
// 5€, bis 00 Uhr 10€, danach 15€"). Rein informativ — es wird nicht online
// bezahlt, die Gäste zahlen an der Abendkasse. Ohne Staffeln bleibt die
// Gästeliste wie gehabt kostenlos.
model GuestlistTier {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Staffel gilt bis zu diesem Zeitpunkt (danach greift die nächste Staffel
  // bzw. bleibt die letzte Staffel als Endpreis bestehen).
  untilTime  DateTime
  priceCents Int

  // Optionaler Name der Staffel (z.B. "Early Bird", "Regular", "Last Call").
  // Wird beim Ticket-Kauf/Gästelisten-Eintrag als Snapshot auf Ticket.tierLabel
  // übernommen, damit spätere Auswertungen (Check-in pro Kategorie) auch dann
  // noch stimmen, wenn Staffeln nachträglich umbenannt/gelöscht werden.
  label      String?

  // Reihenfolge der Staffeln (0 = früheste/günstigste)
  order      Int      @default(0)

  createdAt  DateTime @default(now())

  @@index([eventId])
}

model Ticket {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name        String
  email       String
  phone       String?

  // "VALID" | "CHECKED_IN" | "REFUNDED" | "CANCELLED"
  status      String   @default("VALID")

  amountCents Int?
  currency    String   @default("eur")

  // Snapshot des Namens der Preisstaffel zum Zeitpunkt der Anmeldung/des Kaufs
  // (z.B. "Early Bird") — für die Check-in-Statistik pro Kategorie im Scanner.
  // Null bei Events ohne Staffeln oder bei älteren Tickets vor diesem Feature.
  tierLabel   String?

  stripeSessionId       String? @unique
  stripePaymentIntentId String?

  checkedInAt DateTime?
  checkedInBy String?

  emailSentAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventId])
  @@index([email])
}
