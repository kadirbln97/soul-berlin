// SØUL Berlin — Datenbankschema
//
// Datenbank: Postgres (kostenlos z.B. über Vercel/Neon oder Supabase — nötig für
// Deployment auf Vercel, da SQLite dort nicht funktioniert/persistiert).
// Lokale Entwicklung: entweder eine lokale Postgres-Instanz oder einfach dieselbe
// kostenlose Neon/Supabase-Datenbank auch für "npm run dev" verwenden.
// Enums werden bewusst NICHT verwendet — Werte werden stattdessen per Zod im Code
// validiert (siehe src/lib/validation.ts), das hält das Schema portabel.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  subtitle    String?
  description String

  // Optionale englische Fassung. Bleibt ein Feld leer, wird auf der englischen
  // Seite der deutsche Text angezeigt — so entstehen nie leere Stellen.
  titleEn       String?
  subtitleEn    String?
  descriptionEn String?
  venue       String
  address     String?
  imageUrl    String?

  // true = das Event-Bild wurde mit KI erzeugt oder KI-bearbeitet. Wird auf
  // der Seite als sichtbarer Hinweis eingeblendet (Transparenzpflicht nach
  // Art. 50 KI-VO, gilt seit dem 02.08.2026).
  imageIsAi   Boolean  @default(false)

  dateStart   DateTime
  dateEnd     DateTime?

  // "PAID" | "GUESTLIST" | "BOTH" (Ticketkauf + Gästeliste parallel, Gast wählt
  // selbst) | "EXTERNAL" (Verkauf läuft ausschließlich über den Fremdanbieter)
  ticketMode  String   @default("GUESTLIST")

  // Optionaler Link zu einem externen Ticketshop (z.B. Eventbrite). Ist er
  // gesetzt, erscheint auf der Event-Seite zusätzlich ein Knopf dorthin —
  // egal in welchem Modus. Bei ticketMode "EXTERNAL" ist er die einzige
  // Kaufmöglichkeit und damit Pflicht.
  externalTicketUrl String?

  // Name des Anbieters für die Knopfbeschriftung ("Tickets bei Eventbrite").
  // Leer = neutrale Beschriftung.
  externalTicketLabel String?

  // Preis in Cent (relevant bei ticketMode = PAID oder BOTH)
  priceCents  Int?
  currency    String   @default("eur")

  // optionales Kapazitätslimit (null = unbegrenzt)
  capacity    Int?

  // Optionaler Zeitpunkt, ab dem Gästeliste/Ticketverkauf automatisch
  // schließt (null = kein Verkaufsschluss). Wird auf der Event-Seite als
  // Countdown angezeigt; Checkout/Gästeliste-APIs lehnen Anmeldungen danach ab.
  ticketSalesEndAt DateTime?

  // "DRAFT" | "PUBLISHED"
  status      String   @default("DRAFT")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets         Ticket[]
  guestlistTiers  GuestlistTier[]
  ticketPhases    TicketPhase[]
  discounts       Discount[]
}

// Verkaufsphasen für bezahlte Online-Tickets ("Phase 1: 20 Stück à 10 €,
// danach Phase 2 à 15 €"). Anders als die zeitbasierten GuestlistTier sind
// das echte Kontingente: die Phase bestimmt den Preis, der tatsächlich über
// Stripe kassiert wird.
//
// Eine Phase gilt als geschlossen, sobald EINE der drei Bedingungen zutrifft:
//   1. quantity ist erreicht (ausverkauft),
//   2. untilTime liegt in der Vergangenheit (Zeitfenster vorbei),
//   3. isSoldOut wurde im Admin von Hand gesetzt (vorzeitig schließen).
// Aktiv ist immer die erste noch offene Phase in der Reihenfolge (order).
// Ohne Phasen bleibt alles wie bisher: Event.priceCents gilt als einziger Preis.
model TicketPhase {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Anzeigename der Phase ("Early Bird", "Phase 1", "Last Call").
  label      String

  // Preis dieser Phase in Cent — ersetzt Event.priceCents, solange sie aktiv ist.
  priceCents Int

  // Kontingent dieser Phase. Null = unbegrenzt (dann endet die Phase nur über
  // Zeit oder den manuellen Schalter).
  quantity   Int?

  // Optionaler Zeitpunkt, an dem die Phase automatisch endet. Null = kein
  // Zeitlimit.
  untilTime  DateTime?

  // Manuell im Admin gesetzt: Phase sofort als ausverkauft behandeln, auch
  // wenn das Kontingent noch nicht aufgebraucht ist. Genau dafür gedacht,
  // früher als geplant auf die nächste Phase umzuschalten.
  isSoldOut  Boolean  @default(false)

  // Reihenfolge der Phasen (0 = erste/günstigste).
  order      Int      @default(0)

  createdAt  DateTime @default(now())

  tickets    Ticket[]

  @@index([eventId])
}

// Rabatt-Aktion für ein Event. Entweder als Gutscheincode (Gast tippt ihn im
// Checkout ein) oder automatisch für alle (code = null). Pro Event kann immer
// nur ein automatischer Rabatt aktiv sein — geprüft wird das im Backend.
model Discount {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Groß-/Kleinschreibung wird beim Prüfen ignoriert. Null = gilt automatisch
  // für alle, ohne Eingabe.
  code      String?

  // "PERCENT" = Prozent vom Ticketpreis
  // "FIXED"   = fester Betrag in Cent
  // "BOGO"    = 2 für 1 (je zwei Tickets wird nur eines berechnet)
  type      String

  // Prozentwert (1–100) bei PERCENT, Betrag in Cent bei FIXED, bei BOGO egal.
  value     Int      @default(0)

  label     String?
  active    Boolean  @default(true)

  // Optionales Nutzungslimit (null = unbegrenzt). usedCount zählt eingelöste
  // Bestellungen, nicht einzelne Tickets.
  maxUses   Int?
  usedCount Int      @default(0)

  createdAt DateTime @default(now())

  @@index([eventId])
}

// Bis zu 3 zeitbasierte Preis-Staffeln für Gästeliste-Events (z.B. "bis 23 Uhr
// 5€, bis 00 Uhr 10€, danach 15€"). Rein informativ — es wird nicht online
// bezahlt, die Gäste zahlen an der Abendkasse. Ohne Staffeln bleibt die
// Gästeliste wie gehabt kostenlos.
model GuestlistTier {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Staffel gilt bis zu diesem Zeitpunkt (danach greift die nächste Staffel
  // bzw. bleibt die letzte Staffel als Endpreis bestehen).
  untilTime  DateTime
  priceCents Int

  // Optionaler Name der Staffel (z.B. "Early Bird", "Regular", "Last Call").
  // Wird beim Ticket-Kauf/Gästelisten-Eintrag als Snapshot auf Ticket.tierLabel
  // übernommen, damit spätere Auswertungen (Check-in pro Kategorie) auch dann
  // noch stimmen, wenn Staffeln nachträglich umbenannt/gelöscht werden.
  label      String?

  // Reihenfolge der Staffeln (0 = früheste/günstigste)
  order      Int      @default(0)

  createdAt  DateTime @default(now())

  @@index([eventId])
}

// Frei im Admin-Bereich änderbare Texte/Bilder der Startseite (Überschriften,
// Button-Beschriftungen, Hero-Bild …). Bewusst als einfacher Schlüssel-Wert-
// Speicher, damit später neue Felder ohne Datenbank-Änderung dazukommen
// können — die Liste der Felder samt Standardwerten steht in
// src/lib/siteContent.ts. Fehlt ein Schlüssel, greift automatisch der
// Standardwert aus dem Code.
model SiteContent {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Foto-/Video-Kacheln für die "SØUL in Action"-Galerie auf der Startseite
// (siehe src/components/Gallery.tsx). Reihenfolge, Hinzufügen, Löschen wird
// komplett im Admin-Bereich verwaltet (/admin/gallery) — kein Code-Änderung
// mehr nötig, um Medien auszutauschen.
model GalleryItem {
  id        String   @id @default(cuid())

  // "PHOTO" | "VIDEO"
  type      String

  // Öffentliche URL der Datei (Vercel Blob oder /media/... für die
  // ursprünglich fest eingebauten Medien).
  url       String

  // Nur bei Videos: Vorschaubild, das gezeigt wird, bevor das Video beim
  // Reinscrollen geladen wird. Optional — ohne Poster wird ein einfaches
  // Platzhalter-Tile gezeigt.
  posterUrl String?

  // Optionaler Alt-Text/Videobeschreibung (Barrierefreiheit).
  label     String?

  // true = mit KI erzeugt/bearbeitet — blendet auf der Startseite einen
  // sichtbaren Hinweis über der Kachel ein (Art. 50 KI-VO).
  isAi      Boolean  @default(false)

  // Reihenfolge in der Galerie (0 = zuerst). Wird im Admin-Bereich per
  // Hoch/Runter-Buttons verändert.
  order     Int      @default(0)

  createdAt DateTime @default(now())

  @@index([order])
}

model Ticket {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name        String
  // Bei manuell eingetragenen Promoter-Gästen leer — dort gibt es keine
  // E-Mail und entsprechend auch keinen Mailversand.
  email       String
  phone       String?

  // Manuell im Admin-Bereich eingetragener Gast (z.B. Promoter-Liste). Diese
  // Gäste bekommen keinen QR-Code, sondern werden an der Tür über die
  // Namenssuche eingecheckt.
  isManual    Boolean  @default(false)

  // Wie viele Personen hinter diesem Eintrag stehen — der Gast selbst plus
  // seine Begleitung. Promoter schreiben ihre Listen als "Max Mustermann +2";
  // daraus wird ein Eintrag mit partySize 3. Beim Einchecken an der Tür wird
  // die ganze Gruppe auf einmal eingecheckt, und alle Zählungen (Kapazität,
  // Check-in-Statistik, Anmeldezahlen) rechnen mit Personen statt mit Zeilen.
  // 1 bei allen anderen Tickets: Online-Käufe legen pro Ticket eine eigene
  // Zeile an, dort steht die Stückzahl also schon in der Zeilenzahl.
  partySize   Int      @default(1)

  // Von welchem Promoter der Eintrag stammt — für die Auswertung, wer wie
  // viele Gäste gebracht hat.
  promoterName String?

  // Sprache, in der sich der Gast angemeldet hat ("de"/"en") — bestimmt die
  // Sprache der Ticket-E-Mail.
  locale      String   @default("en")

  // Gewährter Rabatt (Summe für dieses Ticket) und der genutzte Code, als
  // Snapshot für die Auswertung.
  discountCents Int?
  discountCode  String?

  // "VALID" | "CHECKED_IN" | "REFUNDED" | "CANCELLED"
  status      String   @default("VALID")

  // Ticketpreis ohne Servicegebühr (bzw. an der Abendkasse fälliger Betrag
  // bei Gästeliste-Staffeln).
  amountCents Int?

  // Servicegebühr beim Online-Ticketkauf (1 € + 8 %, siehe lib/serviceFee.ts).
  // Null/0 bei Gästeliste-Einträgen. Wird als Snapshot gespeichert, damit
  // spätere Änderungen an der Gebührenformel alte Verkäufe nicht verfälschen.
  feeCents    Int?

  currency    String   @default("eur")

  // Snapshot des Namens der Preisstaffel zum Zeitpunkt der Anmeldung/des Kaufs
  // (z.B. "Early Bird") — für die Check-in-Statistik pro Kategorie im Scanner.
  // Null bei Events ohne Staffeln oder bei älteren Tickets vor diesem Feature.
  tierLabel   String?

  // In welcher Verkaufsphase dieses Ticket gekauft wurde. Grundlage dafür,
  // wie viele Stück einer Phase schon weg sind. Bewusst SetNull statt Cascade:
  // wird eine Phase im Admin gelöscht, sollen die verkauften Tickets erhalten
  // bleiben — sie zählen dann nur keinem Kontingent mehr zu.
  phaseId     String?
  phase       TicketPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  // Bewusst NICHT unique: bei einer Bestellung über mehrere Tickets gehören
  // alle Tickets zur selben Stripe-Session. Der Schutz gegen doppelte
  // Webhook-Zustellung läuft stattdessen über eine Zählprüfung im Webhook.
  stripeSessionId       String?
  stripePaymentIntentId String?

  checkedInAt DateTime?
  checkedInBy String?

  emailSentAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventId])
  @@index([email])
  @@index([stripeSessionId])
  // Wird bei jedem Aufruf der Event-Seite gebraucht, um zu zählen, wie viele
  // Tickets einer Phase schon verkauft sind.
  @@index([phaseId])
}
